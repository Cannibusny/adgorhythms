<%- include('layout-start', { title: 'Admin — ' + event.name, promoter: promoter }) %>

<% if (typeof flash !== 'undefined' && flash) { %>
  <% if (flash.refund === 'success') { %><div class="flash flash-success">Ticket refunded/cancelled successfully.</div><% } %>
  <% if (flash.success) { %><div class="flash flash-success"><%= flash.success %></div><% } %>
  <% if (flash.error) { %><div class="flash flash-error"><%= flash.error %></div><% } %>
<% } %>

<div style="margin-bottom: 1.5rem;">
  <h1><%= event.name %></h1>
  <h2>Event Admin Dashboard</h2>
</div>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
  <div class="card" style="text-align: center; padding: 1.5rem;">
    <div style="font-size: 2rem; font-weight: 700; color: var(--accent);"><%= totalSold %></div>
    <div style="font-size: 0.85rem; color: var(--text-muted);">Tickets Sold</div>
  </div>
  <div class="card" style="text-align: center; padding: 1.5rem;">
    <div style="font-size: 2rem; font-weight: 700; color: var(--success);">$<%= totalRevenue.toFixed(2) %></div>
    <div style="font-size: 0.85rem; color: var(--text-muted);">Total Revenue</div>
  </div>
  <div class="card" style="text-align: center; padding: 1.5rem;">
    <div style="font-size: 2rem; font-weight: 700; color: var(--warning);"><%= checkedIn %></div>
    <div style="font-size: 0.85rem; color: var(--text-muted);">Checked In</div>
  </div>
  <div class="card" style="text-align: center; padding: 1.5rem;">
    <div style="font-size: 2rem; font-weight: 700;"><%= event.max_capacity %></div>
    <div style="font-size: 0.85rem; color: var(--text-muted);">Max Capacity</div>
  </div>
</div>

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
  <div class="card" style="padding: 1rem;">
    <div style="font-size: 0.8rem; color: var(--text-muted);">Date & Time</div>
    <div style="font-weight: 600;">
      <%= new Date(event.event_date).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }) %>
      at <%= new Date(event.event_date).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' }) %>
    </div>
  </div>
  <div class="card" style="padding: 1rem;">
    <div style="font-size: 0.8rem; color: var(--text-muted);">Location</div>
    <div style="font-weight: 600;"><%= event.location %></div>
  </div>
</div>

<div style="display: flex; gap: 0.75rem; margin-bottom: 1.5rem; flex-wrap: wrap;">
  <a href="/events/<%= event.id %>" class="btn btn-primary btn-sm" style="background: transparent; border: 1px solid var(--accent); color: var(--accent);">View Public Page</a>
  <a href="/events/<%= event.id %>/checkin" class="btn btn-primary btn-sm">Open Check-In</a>
  <a href="/events/<%= event.id %>/live" class="btn btn-primary btn-sm" style="background: var(--success);">Live Dashboard</a>
  <a href="/events/<%= event.id %>/admin/export" class="btn btn-primary btn-sm" style="background: transparent; border: 1px solid var(--success); color: var(--success);">Export CSV</a>
</div>

<!-- Ticket Tiers -->
<% if (tiers && tiers.length > 0) { %>
<div class="card" style="padding: 1.5rem; margin-bottom: 1rem;">
  <h3 style="margin-bottom: 1rem;">Ticket Tiers</h3>
  <div style="overflow-x: auto;">
    <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem;">
      <thead>
        <tr style="border-bottom: 1px solid var(--border);">
          <th style="text-align: left; padding: 0.5rem; color: var(--text-muted); font-weight: 500;">Tier</th>
          <th style="text-align: left; padding: 0.5rem; color: var(--text-muted); font-weight: 500;">Price</th>
          <th style="text-align: left; padding: 0.5rem; color: var(--text-muted); font-weight: 500;">Sold / Total</th>
        </tr>
      </thead>
      <tbody>
        <% tiers.forEach(function(tier) { %>
        <tr style="border-bottom: 1px solid var(--border);">
          <td style="padding: 0.5rem; font-weight: 600; color: <%= tier.name === 'VIP' ? 'var(--gold)' : tier.name === 'Student' ? 'var(--success)' : 'var(--text)' %>;"><%= tier.name %></td>
          <td style="padding: 0.5rem;">$<%= parseFloat(tier.price).toFixed(2) %></td>
          <td style="padding: 0.5rem;"><%= tier.sold || 0 %> / <%= tier.quantity %></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<!-- Add Tier Form -->
<div class="card" style="padding: 1.5rem; margin-bottom: 1rem;">
  <h3 style="margin-bottom: 1rem;">Add Ticket Tier</h3>
  <form method="POST" action="/events/<%= event.id %>/admin/tier" style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.75rem; align-items: end;">
    <div>
      <label>Tier Name</label>
      <input type="text" name="name" placeholder="e.g. VIP" required style="margin-bottom: 0;" />
    </div>
    <div>
      <label>Price ($)</label>
      <input type="number" name="price" step="0.01" min="0" placeholder="50.00" required style="margin-bottom: 0;" />
    </div>
    <div>
      <label>Quantity</label>
      <input type="number" name="quantity" min="1" placeholder="100" required style="margin-bottom: 0;" />
    </div>
    <div style="grid-column: 1 / -1;">
      <label>Description (optional)</label>
      <input type="text" name="description" placeholder="Front row, VIP lounge access..." style="margin-bottom: 0;" />
    </div>
    <div>
      <button type="submit" class="btn btn-primary btn-sm">Add Tier</button>
    </div>
  </form>
</div>

<!-- Promo Codes -->
<% if (promos && promos.length > 0) { %>
<div class="card" style="padding: 1.5rem; margin-bottom: 1rem;">
  <h3 style="margin-bottom: 1rem;">Promo Codes</h3>
  <div style="overflow-x: auto;">
    <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem;">
      <thead>
        <tr style="border-bottom: 1px solid var(--border);">
          <th style="text-align: left; padding: 0.5rem; color: var(--text-muted); font-weight: 500;">Code</th>
          <th style="text-align: left; padding: 0.5rem; color: var(--text-muted); font-weight: 500;">Discount</th>
          <th style="text-align: left; padding: 0.5rem; color: var(--text-muted); font-weight: 500;">Used / Max</th>
          <th style="text-align: left; padding: 0.5rem; color: var(--text-muted); font-weight: 500;">Status</th>
        </tr>
      </thead>
      <tbody>
        <% promos.forEach(function(p) { %>
        <tr style="border-bottom: 1px solid var(--border);">
          <td style="padding: 0.5rem; font-family: monospace; font-weight: 600;"><%= p.code %></td>
          <td style="padding: 0.5rem;"><%= p.discount_type === 'percentage' ? p.discount_value + '%' : '$' + parseFloat(p.discount_value).toFixed(2) %></td>
          <td style="padding: 0.5rem;"><%= p.times_used %> / <%= p.max_uses || 'Unlimited' %></td>
          <td style="padding: 0.5rem;"><span style="color: <%= p.active ? 'var(--success)' : 'var(--error)' %>;"><%= p.active ? 'Active' : 'Disabled' %></span></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<!-- Add Promo Code Form -->
<div class="card" style="padding: 1.5rem; margin-bottom: 1rem;">
  <h3 style="margin-bottom: 1rem;">Add Promo Code</h3>
  <form method="POST" action="/events/<%= event.id %>/admin/promo" style="display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 0.75rem; align-items: end;">
    <div>
      <label>Code</label>
      <input type="text" name="code" placeholder="EARLYBIRD" required style="margin-bottom: 0; text-transform: uppercase;" />
    </div>
    <div>
      <label>Type</label>
      <select name="discountType" style="margin-bottom: 0;">
        <option value="percentage">Percentage</option>
        <option value="fixed">Fixed ($)</option>
      </select>
    </div>
    <div>
      <label>Value</label>
      <input type="number" name="discountValue" step="0.01" min="0" placeholder="10" required style="margin-bottom: 0;" />
    </div>
    <div>
      <label>Max Uses (blank = unlimited)</label>
      <input type="number" name="maxUses" min="1" placeholder="Unlimited" style="margin-bottom: 0;" />
    </div>
    <div>
      <button type="submit" class="btn btn-primary btn-sm">Add Code</button>
    </div>
  </form>
</div>

<!-- Attendee List -->
<div class="card" style="padding: 1.5rem;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
    <h3>Attendee List</h3>
    <input type="text" id="search-input" placeholder="Search attendees..." style="max-width: 250px; margin-bottom: 0;" oninput="filterAttendees()" />
  </div>

  <% if (tickets.length === 0) { %>
    <div style="text-align: center; padding: 2rem; color: var(--text-muted);">No tickets sold yet.</div>
  <% } else { %>
    <div style="overflow-x: auto;">
      <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem;" id="attendee-table">
        <thead>
          <tr style="border-bottom: 1px solid var(--border);">
            <th style="text-align: left; padding: 0.75rem 0.5rem; color: var(--text-muted); font-weight: 500;">Name</th>
            <th style="text-align: left; padding: 0.75rem 0.5rem; color: var(--text-muted); font-weight: 500;">Email</th>
            <th style="text-align: left; padding: 0.75rem 0.5rem; color: var(--text-muted); font-weight: 500;">Tier</th>
            <th style="text-align: left; padding: 0.75rem 0.5rem; color: var(--text-muted); font-weight: 500;">Status</th>
            <th style="text-align: left; padding: 0.75rem 0.5rem; color: var(--text-muted); font-weight: 500;">Paid</th>
            <th style="text-align: right; padding: 0.75rem 0.5rem; color: var(--text-muted); font-weight: 500;">Action</th>
          </tr>
        </thead>
        <tbody>
          <% tickets.forEach(function(t) { %>
            <% var statusColor = t.status === 'checked_in' ? 'var(--success)' : t.status === 'cancelled' ? 'var(--error)' : 'var(--text-muted)'; %>
            <% var statusText = t.status === 'checked_in' ? 'Checked In' : t.status === 'cancelled' ? 'Cancelled' : 'Confirmed'; %>
            <% var tierColor = t.tier_name === 'VIP' ? 'var(--gold)' : t.tier_name === 'Student' ? 'var(--success)' : 'var(--text)'; %>
            <tr class="attendee-row" style="border-bottom: 1px solid var(--border);">
              <td style="padding: 0.75rem 0.5rem;"><%= t.buyer_name %></td>
              <td style="padding: 0.75rem 0.5rem; color: var(--text-muted);"><%= t.buyer_email %></td>
              <td style="padding: 0.75rem 0.5rem; color: <%= tierColor %>; font-weight: 600;"><%= t.tier_name || 'General' %></td>
              <td style="padding: 0.75rem 0.5rem;">
                <span style="color: <%= statusColor %>; font-weight: 600;"><%= statusText %></span>
                <% if (t.checked_in_at) { %>
                  <div style="font-size: 0.75rem; color: var(--text-muted);"><%= new Date(t.checked_in_at).toLocaleTimeString() %></div>
                <% } %>
              </td>
              <td style="padding: 0.75rem 0.5rem;">$<%= parseFloat(t.amount_paid).toFixed(2) %></td>
              <td style="padding: 0.75rem 0.5rem; text-align: right;">
                <% if (t.status !== 'cancelled') { %>
                  <form method="POST" action="/events/<%= event.id %>/admin/refund/<%= t.id %>" style="display: inline;" onsubmit="return confirm('Refund/cancel this ticket?')">
                    <button type="submit" class="btn btn-danger btn-sm">Refund</button>
                  </form>
                <% } else { %>
                  <span style="color: var(--text-muted);">&mdash;</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<div style="text-align: center; margin-top: 1.5rem;">
  <a href="/events" style="color: var(--text-muted); text-decoration: none;">&larr; Back to My Events</a>
</div>

<script>
function filterAttendees() {
  var query = document.getElementById('search-input').value.toLowerCase();
  var rows = document.querySelectorAll('.attendee-row');
  rows.forEach(function(row) {
    var text = row.textContent.toLowerCase();
    row.style.display = text.includes(query) ? '' : 'none';
  });
}
</script>

<%- include('layout-end', { registerSW: false }) %>
