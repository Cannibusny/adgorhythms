<% var title = 'Login — ADgorhythms Event Suite'; var promoter = null; %>
<%- include('layout', { body: `
  <div style="max-width: 420px; margin: 3rem auto;">
    <h1>Sign In</h1>
    <h2>ADgorhythms Event Suite</h2>

    ${error ? '<p class="error-msg">' + error + '</p>' : ''}

    <form method="POST" action="/login">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" required placeholder="you@business.com" />

      <label for="password">Password</label>
      <input type="password" id="password" name="password" required placeholder="Your password" />

      <button type="submit" class="btn btn-primary" style="width:100%; margin-top: 0.5rem;">Sign In</button>
    </form>

    <p style="text-align:center; margin-top:1.5rem; color: var(--text-muted); font-size: 0.9rem;">
      Don't have an account? <a href="/register" style="color: var(--accent);">Register</a>
    </p>
  </div>
` }) %>
