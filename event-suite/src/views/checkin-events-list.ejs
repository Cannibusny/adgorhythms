<%- include('layout-start', { title: 'Check-In Events', promoter: promoter }) %>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
  <div>
    <h1>My Events</h1>
    <h2 style="color: var(--text-muted); font-size: 1rem;">Check-in management for all your events</h2>
  </div>
  <a href="/checkin/new" class="btn btn-primary">+ New Event</a>
</div>

<% if (events.length === 0) { %>
<div class="card" style="padding: 3rem; text-align: center;">
  <div style="font-size: 3rem; margin-bottom: 1rem;">🎪</div>
  <h3>No events yet</h3>
  <p style="color: var(--text-muted);">Create your first event to start managing check-ins.</p>
  <a href="/checkin/new" class="btn btn-primary" style="margin-top: 1rem;">Create Event</a>
</div>
<% } else { %>
<div style="display: grid; gap: 1rem;">
  <% events.forEach(function(event) { %>
  <div class="card" style="padding: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <div>
      <h3 style="margin: 0 0 0.25rem 0;"><%= event.name %></h3>
      <div style="color: var(--text-muted); font-size: 0.85rem;">
        <%= new Date(event.event_date).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }) %>
        &bull; <%= event.location %>
        &bull; <%= event.city || 'NYC' %>
      </div>
      <div style="margin-top: 0.5rem; display: flex; gap: 1rem; font-size: 0.9rem;">
        <span style="color: var(--accent);"><strong><%= event.total_attendees || 0 %></strong> registered</span>
        <span style="color: var(--success);"><strong><%= event.checked_in_count || 0 %></strong> checked in</span>
      </div>
    </div>
    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
      <a href="/checkin/<%= event.id %>/edit" class="btn btn-sm" style="background: var(--surface-2); color: var(--warning);">Edit</a>
      <a href="/checkin/<%= event.id %>/registrations" class="btn btn-sm" style="background: var(--surface-2); color: var(--text);">Registrations</a>
      <a href="/checkin/<%= event.id %>/qr" class="btn btn-sm" style="background: var(--gold); color: #000;">QR Code</a>
      <a href="/checkin/<%= event.id %>/admin" class="btn btn-sm" style="background: var(--surface-2); color: var(--text);">Admin</a>
      <a href="/checkin/<%= event.id %>/scan" class="btn btn-sm" style="background: var(--accent); color: #fff;">Check-In</a>
      <a href="/checkin/<%= event.id %>/live" class="btn btn-sm" style="background: var(--success); color: #fff;">Live</a>
    </div>
  </div>
  <% }); %>
</div>
<% } %>

<%- include('layout-end') %>
