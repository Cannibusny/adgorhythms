<%- include('layout-start', { title: 'Live — ' + event.name, promoter: promoter }) %>

<div style="text-align: center; margin-bottom: 1.5rem;">
  <h1><%= event.name %></h1>
  <h2>Live Event Dashboard</h2>
  <div style="font-size: 0.8rem; color: var(--text-muted);" id="lastUpdate">Updating...</div>
</div>

<!-- Big Attendance Counter -->
<div class="card" style="padding: 2.5rem; text-align: center; margin-bottom: 1.5rem; border-color: var(--accent);">
  <div style="font-size: 4rem; font-weight: 800; line-height: 1;" id="bigCounter">- / -</div>
  <div style="font-size: 1.1rem; color: var(--text-muted); margin-top: 0.5rem;">Checked In / Total Sold</div>
  <div style="width: 100%; height: 12px; background: var(--surface-2); border-radius: 6px; margin-top: 1rem; overflow: hidden;">
    <div id="progressBar" style="height: 100%; background: var(--success); border-radius: 6px; transition: width 0.5s; width: 0%;"></div>
  </div>
  <div style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.5rem;" id="progressPercent">0%</div>
</div>

<!-- Tier Breakdown -->
<div class="stat-grid" style="grid-template-columns: 1fr 1fr 1fr; margin-bottom: 1.5rem;">
  <div class="stat-card" style="border-color: var(--gold);">
    <div class="stat-number" style="color: var(--gold);" id="vipCount">-</div>
    <div class="stat-label">VIP</div>
    <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.25rem;" id="vipDetail">- / - checked in</div>
  </div>
  <div class="stat-card">
    <div class="stat-number" style="color: var(--accent);" id="generalCount">-</div>
    <div class="stat-label">General</div>
    <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.25rem;" id="generalDetail">- / - checked in</div>
  </div>
  <div class="stat-card" style="border-color: var(--success);">
    <div class="stat-number" style="color: var(--success);" id="studentCount">-</div>
    <div class="stat-label">Student</div>
    <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.25rem;" id="studentDetail">- / - checked in</div>
  </div>
</div>

<!-- Revenue -->
<div class="stat-grid" style="grid-template-columns: 1fr 1fr; margin-bottom: 1.5rem;">
  <div class="stat-card">
    <div class="stat-number" style="color: var(--success);" id="revenueTotal">$0.00</div>
    <div class="stat-label">Total Revenue</div>
  </div>
  <div class="stat-card">
    <div class="stat-number" id="capacityPct">0%</div>
    <div class="stat-label">Capacity Used</div>
  </div>
</div>

<!-- Search -->
<div class="card" style="padding: 1.5rem; margin-bottom: 1rem;">
  <h3 style="margin-bottom: 0.75rem;">Search Attendees</h3>
  <input type="text" id="searchInput" placeholder="Search by name, email, or phone..." style="font-size: 1rem; margin-bottom: 0.5rem;" />
  <div id="searchResults" style="max-height: 300px; overflow-y: auto;"></div>
</div>

<!-- Live Feed -->
<div class="card" style="padding: 1.5rem;">
  <h3 style="margin-bottom: 0.75rem;">Recent Check-Ins</h3>
  <div id="liveFeed" style="max-height: 400px; overflow-y: auto;"></div>
</div>

<div style="text-align: center; margin-top: 1.5rem; display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
  <a href="/events/<%= event.id %>/admin" style="color: var(--text-muted); text-decoration: none;">&larr; Admin Dashboard</a>
  <a href="/events/<%= event.id %>/checkin" style="color: var(--accent); text-decoration: none;">Open Check-In &rarr;</a>
</div>

<script>
var eventId = '<%= event.id %>';
var maxCapacity = <%= event.max_capacity %>;

function refreshDashboard() {
  fetch('/events/' + eventId + '/stats')
    .then(function(r) { return r.json(); })
    .then(function(s) {
      var totalSold = parseInt(s.total_sold) || 0;
      var checkedIn = parseInt(s.checked_in) || 0;
      var pct = totalSold > 0 ? Math.round((checkedIn / totalSold) * 100) : 0;
      var capPct = maxCapacity > 0 ? Math.round((totalSold / maxCapacity) * 100) : 0;

      document.getElementById('bigCounter').textContent = checkedIn + ' / ' + totalSold;
      document.getElementById('progressBar').style.width = pct + '%';
      document.getElementById('progressPercent').textContent = pct + '% checked in';
      document.getElementById('capacityPct').textContent = capPct + '%';

      document.getElementById('vipCount').textContent = s.vip_sold || 0;
      document.getElementById('vipDetail').textContent = (s.vip_checked_in || 0) + ' / ' + (s.vip_sold || 0) + ' checked in';
      document.getElementById('generalCount').textContent = s.general_sold || 0;
      document.getElementById('generalDetail').textContent = (s.general_checked_in || 0) + ' / ' + (s.general_sold || 0) + ' checked in';
      document.getElementById('studentCount').textContent = s.student_sold || 0;
      document.getElementById('studentDetail').textContent = (s.student_checked_in || 0) + ' / ' + (s.student_sold || 0) + ' checked in';

      var rev = parseFloat(s.total_revenue) || 0;
      document.getElementById('revenueTotal').textContent = '$' + rev.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      document.getElementById('lastUpdate').textContent = 'Updated ' + new Date().toLocaleTimeString();
    }).catch(function() {});

  fetch('/events/' + eventId + '/recent')
    .then(function(r) { return r.json(); })
    .then(function(list) {
      var html = '';
      list.forEach(function(a) {
        var time = a.checked_in_at ? new Date(a.checked_in_at).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' }) : '';
        var tierColor = a.tier_name === 'VIP' ? 'var(--gold)' : a.tier_name === 'Student' ? 'var(--success)' : 'var(--text-muted)';
        html += '<div style="padding: 0.6rem 0; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;">';
        html += '<div><strong>' + a.buyer_name + '</strong> <span style="color: ' + tierColor + '; font-size: 0.85rem;">' + (a.tier_name || 'General') + '</span></div>';
        html += '<span style="color: var(--text-muted); font-size: 0.85rem;">' + time + '</span>';
        html += '</div>';
      });
      document.getElementById('liveFeed').innerHTML = html || '<p style="color: var(--text-muted); text-align: center;">Waiting for check-ins...</p>';
    }).catch(function() {});
}

var searchTimeout;
document.getElementById('searchInput').addEventListener('input', function() {
  clearTimeout(searchTimeout);
  var q = this.value.trim();
  if (q.length < 2) { document.getElementById('searchResults').innerHTML = ''; return; }
  searchTimeout = setTimeout(function() {
    fetch('/events/' + eventId + '/search?q=' + encodeURIComponent(q))
      .then(function(r) { return r.json(); })
      .then(function(results) {
        var html = '';
        results.forEach(function(a) {
          var tierColor = a.tier_name === 'VIP' ? 'var(--gold)' : a.tier_name === 'Student' ? 'var(--success)' : 'var(--text-muted)';
          var status = a.status === 'checked_in' ? '<span style="color: var(--success);">Checked In</span>' : '<span style="color: var(--text-muted);">Not Yet</span>';
          html += '<div style="padding: 0.6rem 0; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;">';
          html += '<div><strong>' + a.buyer_name + '</strong> <span style="color: ' + tierColor + '; font-size: 0.85rem;">' + (a.tier_name || 'General') + '</span></div>';
          html += '<div>' + status + '</div>';
          html += '</div>';
        });
        document.getElementById('searchResults').innerHTML = html || '<p style="color: var(--text-muted);">No results</p>';
      }).catch(function() {});
  }, 300);
});

refreshDashboard();
setInterval(refreshDashboard, 3000);
</script>

<%- include('layout-end', { registerSW: true }) %>
