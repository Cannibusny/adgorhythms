<%- include('layout-start', { title: 'Create Event', promoter: promoter }) %>

<h1>Create Event</h1>
<h2>Set up a new event with registration + check-in</h2>

<% if (typeof error !== 'undefined' && error) { %>
<div class="flash flash-error"><%= error %></div>
<% } %>

<div class="card" style="padding: 2rem;">
  <form method="POST" action="/checkin/new">
    <h3 style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 1px;">Event Details</h3>

    <label for="name">Event Name *</label>
    <input type="text" name="name" id="name" placeholder="Father's Day Roast & Toast Comedy Show + Day Party" required value="<%= typeof form !== 'undefined' && form ? form.name || '' : '' %>" />

    <label for="description">Description</label>
    <textarea name="description" id="description" rows="3" placeholder="Comedy, food, drinks, and good vibes. Cash bar available. Payments due on-site."><%= typeof form !== 'undefined' && form ? form.description || '' : '' %></textarea>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
      <div>
        <label for="date">Date *</label>
        <input type="date" name="date" id="date" required value="<%= typeof form !== 'undefined' && form ? form.date || '' : '' %>" />
      </div>
      <div>
        <label for="time">Time *</label>
        <input type="time" name="time" id="time" required value="<%= typeof form !== 'undefined' && form ? form.time || '' : '' %>" />
      </div>
    </div>

    <label for="location">Venue / Location *</label>
    <input type="text" name="location" id="location" placeholder="Co-op City Community Center, Bronx" required value="<%= typeof form !== 'undefined' && form ? form.location || '' : '' %>" />

    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
      <div>
        <label for="city">City</label>
        <input type="text" name="city" id="city" placeholder="Bronx, NY" value="<%= typeof form !== 'undefined' && form ? form.city || '' : '' %>" />
      </div>
      <div>
        <label for="region">Region</label>
        <input type="text" name="region" id="region" placeholder="NYC" value="<%= typeof form !== 'undefined' && form ? form.region || 'NYC' : 'NYC' %>" />
      </div>
      <div>
        <label for="currency">Currency</label>
        <select name="currency" id="currency">
          <option value="USD" selected>USD ($)</option>
          <option value="EUR">EUR</option>
          <option value="GBP">GBP</option>
          <option value="JMD">JMD</option>
        </select>
      </div>
    </div>

    <!-- Package Configuration -->
    <h3 style="font-size: 0.9rem; color: var(--text-muted); margin: 1.5rem 0 1rem; text-transform: uppercase; letter-spacing: 1px; padding-top: 1rem; border-top: 1px solid var(--border);">Table / Package Options</h3>
    <p style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 1rem;">Define the packages guests can select during registration. Leave empty for no packages.</p>

    <div id="packages-container">
      <!-- Gold Packages -->
      <div style="margin-bottom: 1rem;">
        <label style="color: #FFD700; font-weight: 600; font-size: 0.85rem;">GOLD PACKAGES</label>
        <div class="package-row" style="display: grid; grid-template-columns: 2fr 1fr 2fr; gap: 0.5rem; margin-bottom: 0.5rem;">
          <input type="text" name="pkg_name[]" placeholder="Table for 2" value="Table for 2" style="margin-bottom: 0;" />
          <input type="number" name="pkg_price[]" placeholder="150" value="150" style="margin-bottom: 0;" />
          <input type="text" name="pkg_desc[]" placeholder="1 Bottle + Food for 2" value="1 Bottle + Food for 2" style="margin-bottom: 0;" />
          <input type="hidden" name="pkg_tier[]" value="Gold" />
        </div>
        <div class="package-row" style="display: grid; grid-template-columns: 2fr 1fr 2fr; gap: 0.5rem; margin-bottom: 0.5rem;">
          <input type="text" name="pkg_name[]" placeholder="Table for 4" value="Table for 4" style="margin-bottom: 0;" />
          <input type="number" name="pkg_price[]" placeholder="300" value="300" style="margin-bottom: 0;" />
          <input type="text" name="pkg_desc[]" placeholder="2 Bottles + Food for 2" value="2 Bottles + Food for 2" style="margin-bottom: 0;" />
          <input type="hidden" name="pkg_tier[]" value="Gold" />
        </div>
        <div class="package-row" style="display: grid; grid-template-columns: 2fr 1fr 2fr; gap: 0.5rem; margin-bottom: 0.5rem;">
          <input type="text" name="pkg_name[]" placeholder="Table for 8" value="Table for 8" style="margin-bottom: 0;" />
          <input type="number" name="pkg_price[]" placeholder="600" value="600" style="margin-bottom: 0;" />
          <input type="text" name="pkg_desc[]" placeholder="4 Bottles + Food for 2" value="4 Bottles + Food for 2" style="margin-bottom: 0;" />
          <input type="hidden" name="pkg_tier[]" value="Gold" />
        </div>
      </div>

      <!-- Premium Packages -->
      <div style="margin-bottom: 1rem;">
        <label style="color: #c792ea; font-weight: 600; font-size: 0.85rem;">PREMIUM PACKAGES</label>
        <div class="package-row" style="display: grid; grid-template-columns: 2fr 1fr 2fr; gap: 0.5rem; margin-bottom: 0.5rem;">
          <input type="text" name="pkg_name[]" placeholder="Table for 2" value="Table for 2" style="margin-bottom: 0;" />
          <input type="number" name="pkg_price[]" placeholder="175" value="175" style="margin-bottom: 0;" />
          <input type="text" name="pkg_desc[]" placeholder="1 Bottle + Food for 2" value="1 Bottle + Food for 2" style="margin-bottom: 0;" />
          <input type="hidden" name="pkg_tier[]" value="Premium" />
        </div>
        <div class="package-row" style="display: grid; grid-template-columns: 2fr 1fr 2fr; gap: 0.5rem; margin-bottom: 0.5rem;">
          <input type="text" name="pkg_name[]" placeholder="Table for 4" value="Table for 4" style="margin-bottom: 0;" />
          <input type="number" name="pkg_price[]" placeholder="350" value="350" style="margin-bottom: 0;" />
          <input type="text" name="pkg_desc[]" placeholder="2 Bottles + Food for 2" value="2 Bottles + Food for 2" style="margin-bottom: 0;" />
          <input type="hidden" name="pkg_tier[]" value="Premium" />
        </div>
        <div class="package-row" style="display: grid; grid-template-columns: 2fr 1fr 2fr; gap: 0.5rem; margin-bottom: 0.5rem;">
          <input type="text" name="pkg_name[]" placeholder="Table for 8" value="Table for 8" style="margin-bottom: 0;" />
          <input type="number" name="pkg_price[]" placeholder="700" value="700" style="margin-bottom: 0;" />
          <input type="text" name="pkg_desc[]" placeholder="4 Bottles + Food for 2" value="4 Bottles + Food for 2" style="margin-bottom: 0;" />
          <input type="hidden" name="pkg_tier[]" value="Premium" />
        </div>
      </div>
    </div>

    <p style="font-size: 0.75rem; color: var(--text-muted); margin-bottom: 1rem;">
      Columns: Package Name | Price ($) | Description. Bottles: Gold Henny, Tito's, Casamigos, Don Julio | Premium Henny VSOP, Rose Moet
    </p>

    <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 0.5rem;">Create Event</button>
  </form>
</div>

<div style="text-align: center; margin-top: 1rem;">
  <a href="/checkin" style="color: var(--text-muted); text-decoration: none;">&larr; Back to My Events</a>
</div>

<%- include('layout-end') %>
