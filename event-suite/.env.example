# Server
PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=your-session-secret-here
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:pass@host:port/dbname

# Encryption (32-byte hex string — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=

# Meta (Facebook) OAuth
META_APP_ID=
META_APP_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_CLIENT_ID=

# Twilio (used for system-level alerts; promoters supply their own creds)
TWILIO_PHONE_NUMBER=

# Klaviyo (no system-level key needed; promoters supply their own)

# Cron secret (used by Vercel cron endpoint for token refresh auth)
CRON_SECRET=
