            "index": 0
          }
        ]
      ]
    },
    "Klaviyo — Create VIP Profile": {
      "main": [
        [
          {
            "node": "Twilio — Welcome SMS",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Twilio — Welcome SMS": {
      "main": [
        [
          {
            "node": "Respond 200 OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
