{
  "name": "cannibusny-automation-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Cannibus NY Automation Engine — lead capture webhook API with Klaviyo + Twilio integrations and n8n workflow blueprints",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "dotenv": "16.4.5",
    "express": "4.21.2",
    "helmet": "7.1.0",
    "libphonenumber-js": "1.11.17",
    "twilio": "5.4.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.14",
    "@types/node": "20.17.12",
    "@types/supertest": "6.0.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jest": "29.7.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.19.1"
  }
}
